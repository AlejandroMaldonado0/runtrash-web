# API
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_HOURS=12
MAX_UPLOAD_MB=8

# En hosting con proxy (Render, Railway, Fly) ponlo en true
TRUST_PROXY=false

# PostgreSQL
# Opción A (recomendada en la nube): pega aqui la URL que te da
# Neon, Supabase, Railway o Render. Ejemplo:
#   postgresql://usuario:clave@host/neon_db?sslmode=require
DATABASE_URL=

# Opción B (solo para tu computador): variables separadas
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Runtrash
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_SSL=false

# Opcional: publica el frontend desde el mismo servicio.
# Con esto basta un unico dominio y no hay que configurar CORS.
# Ruta ABSOLUTA a la carpeta que contiene los .html
FRONTEND_DIR=

# Administrador inicial (se crea/actualiza al iniciar la API)
# IMPORTANTE: la clave debe tener minimo 8 caracteres
ADMIN_NAME=Administrador RunTrash
ADMIN_EMAIL=admin@runtrash.co
ADMIN_PASSWORD=cambia_esta_clave_de_administrador

# Recuperación de contraseña
# Minutos de validez del código de 6 dígitos
RECUPERACION_MINUTOS=20
# Intentos máximo antes de bloquear el código
RECUPERACION_INTENTOS=5
# true (demo): el código se devuelve en la respuesta y se muestra en pantalla.
# false (producción): el código nunca sale del servidor; debe enviarse por correo.
EXPOSER_CODIGO_RECUPERACION=true
